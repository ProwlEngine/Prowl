<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	  <TargetType>library</TargetType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>8600;8601;8618;8602;8603;8604;8625;1591;NU1902;NU1903</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Allow test project to access internal members -->
  <ItemGroup>
    <InternalsVisibleTo Include="Prowl.Runtime.Test" />
    <InternalsVisibleTo Include="Prowl.Editor" />
    <InternalsVisibleTo Include="Prowl.Editor.Test" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>../Build/Runtime/Debug/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>../Build/Runtime/Release/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jitter2" Version="2.8.5" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.13.0" />
    <PackageReference Include="Prowl.Clay" Version="$(ProwlPackageVersion)" />
    <PackageReference Include="Prowl.Echo" Version="$(ProwlPackageVersion)" />
    <PackageReference Include="Prowl.Paper" Version="$(ProwlPackageVersion)" />
    <PackageReference Include="Prowl.Quill" Version="$(ProwlPackageVersion)" />
    <PackageReference Include="Prowl.Unwrapper" Version="$(ProwlPackageVersion)" />
    <PackageReference Include="Prowl.Graphite" Version="$(ProwlPackageVersion)" />
    <PackageReference Include="Prowl.Graphite.ShaderDef" Version="$(ProwlPackageVersion)" />
    <PackageReference Include="Prowl.Ember.Contracts" Version="$(ProwlPackageVersion)" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input.Glfw" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input.Sdl" Version="2.23.0" />
    <PackageReference Include="Silk.NET.SDL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.GLFW" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <!-- EngineObject null-safety analyzer (?./??/??= on EngineObject). Analyzes this project's own source. -->
    <ProjectReference Include="..\Prowl.Analyzers\Prowl.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Defaults\**" />
    <EmbeddedResource Include="Assets\brdf_lut.brdf" />
    <EmbeddedResource Include="Assets\Shaders\**" />
  </ItemGroup>

  <ItemGroup>
    <LibraryFiles Include="..\Libraries\**\*.*" />
  </ItemGroup>

  <!-- Precompiled shader blobs (Tools/DefaultShaderCompiler.cs, Tools/UIShaderCompiler.cs). Neither
       tool references this project - they compile against the Prowl.Echo/Prowl.Graphite packages
       directly - so running them here ahead of compilation is not a build-order cycle. Skipped when
       the committed .shaderblob outputs are already newer than their sources. -->
  <ItemGroup>
    <DefaultShaderSource Include="Assets\Defaults\*.shader" />
    <DefaultShaderBlob Include="Assets\Defaults\Compiled\*.shaderblob" />
    <UISlangSource Include="GUI\Shaders\*.slang" />
    <UIShaderBlob Include="Assets\Shaders\*.shaderblob" />
  </ItemGroup>

  <Target Name="CompileDefaultShaders" BeforeTargets="BeforeCompile"
          Inputs="@(DefaultShaderSource)" Outputs="@(DefaultShaderBlob)">
    <Exec Command="dotnet run DefaultShaderCompiler.cs" WorkingDirectory="$(MSBuildThisFileDirectory)..\Tools" />
  </Target>

  <Target Name="CompileUIShaders" BeforeTargets="BeforeCompile"
          Inputs="@(UISlangSource)" Outputs="@(UIShaderBlob)">
    <Exec Command="dotnet run UIShaderCompiler.cs" WorkingDirectory="$(MSBuildThisFileDirectory)..\Tools" />
  </Target>

  <!-- Stamp each PackageReference as AssemblyMetadata so the build pipeline
       can read dependencies from the compiled DLL without needing the .csproj file. -->
  <Target Name="EmbedPackageReferences" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>PackageReference:%(PackageReference.Identity)</_Parameter1>
        <_Parameter2>%(PackageReference.Version)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- Copy native libraries to output -->
  <Target Name="CopyLibraries" AfterTargets="Build">
    <Copy SourceFiles="@(LibraryFiles)" DestinationFiles="@(LibraryFiles->'$(OutputPath)runtimes\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- Collect runtime files for referencing projects -->
  <ItemGroup>
    <None Include="..\Libraries\**\*.*">
      <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
