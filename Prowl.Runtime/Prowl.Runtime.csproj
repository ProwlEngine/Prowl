<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	  <TargetType>library</TargetType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>8600;8601;8618;8602;8603;8604;8625;1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Allow test project to access internal members -->
  <ItemGroup>
    <InternalsVisibleTo Include="Prowl.Runtime.Test" />
    <InternalsVisibleTo Include="Prowl.Editor" />
    <InternalsVisibleTo Include="Prowl.Editor.Test" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>../Build/Runtime/Debug/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>../Build/Runtime/Release/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Anthology\Aperture\Aperture\Aperture.csproj" />
    <ProjectReference Include="..\..\Anthology\Clay\Clay\Clay.csproj" />
    <ProjectReference Include="..\..\Anthology\Echo\Echo\Echo.csproj" />
    <ProjectReference Include="..\..\Anthology\Paper\Paper\Paper.csproj" />
    <ProjectReference Include="..\..\Anthology\Recast\Recast\Prowl.Recast.csproj" />
    <ProjectReference Include="..\..\Anthology\Motion\Motion\Motion.csproj" />
    <ProjectReference Include="..\..\Anthology\Unwrapper\Unwrapper\Unwrapper.csproj" />
    <ProjectReference Include="..\..\Anthology\Ember\Contracts\Prowl.Ember.Contracts.csproj" />
    <ProjectReference Include="..\..\Anthology\Ember\Analyzers\Prowl.Ember.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Anthology\Graphite\Graphite\Prowl.Graphite.csproj" />
    <ProjectReference Include="..\..\Anthology\Graphite\ShaderDef\Core\Prowl.Graphite.ShaderDef.csproj" />
    <ProjectReference Include="..\..\Anthology\Graphite\ShaderDef\Compiler\Prowl.Graphite.ShaderDef.Compiler.csproj" />
    <ProjectReference Include="..\..\Anthology\Graphite\Rendering\Prowl.Graphite.Rendering.csproj" />

    <PackageReference Include="Jitter2" Version="2.13.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input.Glfw" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenXR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenXR.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenXR.Extensions.EXT" Version="2.23.0" />
    <!-- EngineObject null-safety analyzer (?./??/??= on EngineObject). Analyzes this project's own source. -->
    <ProjectReference Include="..\Prowl.Analyzers\Prowl.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Defaults\**" />
  </ItemGroup>

  <ItemGroup>
    <LibraryFiles Include="..\Libraries\**\*.*" />
  </ItemGroup>

  <!-- Stamp each PackageReference and engine native library as AssemblyMetadata so the build pipeline
       can read dependencies from the compiled DLL without needing the .csproj file. -->
  <Target Name="EmbedPackageReferences" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>PackageReference:%(PackageReference.Identity)</_Parameter1>
        <_Parameter2>%(PackageReference.Version)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>NativeLibrary:%(LibraryFiles.RecursiveDir)%(LibraryFiles.Filename)%(LibraryFiles.Extension)</_Parameter1>
        <_Parameter2>runtimes</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- Copy native libraries to output -->
  <Target Name="CopyLibraries" AfterTargets="Build">
    <Copy SourceFiles="@(LibraryFiles)" DestinationFiles="@(LibraryFiles->'$(OutputPath)runtimes\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- Collect runtime files for referencing projects -->
  <ItemGroup>
    <None Include="..\Libraries\**\*.*">
      <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
