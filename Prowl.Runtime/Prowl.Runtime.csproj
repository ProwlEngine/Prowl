<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	  <TargetType>library</TargetType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>8600;8601;8618;8602;8603;8604;8625;1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Prowl.Runtime</PackageId>
    <Version>$(ProwlVersion)</Version>
    <Description>The runtime half of the Prowl game engine - an open-source, MIT-licensed, Unity-like engine written in pure C#. Reference this package to build and ship a game as an ordinary .NET application, with no dependency on the Prowl Editor.</Description>
  </PropertyGroup>

  <!-- Allow test project to access internal members -->
  <ItemGroup>
    <InternalsVisibleTo Include="Prowl.Runtime.Test" />
    <InternalsVisibleTo Include="Prowl.Editor" />
    <InternalsVisibleTo Include="Prowl.Editor.Test" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>../Build/Runtime/Debug/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>../Build/Runtime/Release/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- <PackageReference Include="Jitter2" Version="2.2.0" /> -->
    <PackageReference Include="Jitter2" Version="2.8.13" />

    <!-- <ProjectReference Include="..\..\Anthology\Aperture\Aperture\Aperture.csproj" /> -->
    <!-- <ProjectReference Include="..\..\Anthology\Clay\Clay\Clay.csproj" /> -->
    <!-- <ProjectReference Include="..\..\Anthology\Echo\Echo\Echo.csproj" /> -->
    <!-- <ProjectReference Include="..\..\Anthology\Paper\Paper\Paper.csproj" /> -->
    <!-- <ProjectReference Include="..\..\Anthology\Recast\Recast\Prowl.Recast.csproj" /> -->
    <!-- <ProjectReference Include="..\..\Anthology\Unwrapper\Unwrapper\Unwrapper.csproj" /> -->
    <PackageReference Include="Prowl.Aperture" Version="$(ProwlPackageVersion)" />
    <PackageReference Include="Prowl.Clay" Version="$(ProwlPackageVersion)" />
    <PackageReference Include="Prowl.Echo" Version="$(ProwlPackageVersion)" />
    <PackageReference Include="Prowl.Paper" Version="$(ProwlPackageVersion)" />
    <PackageReference Include="Prowl.Recast" Version="$(ProwlPackageVersion)" />
    <PackageReference Include="Prowl.Unwrapper" Version="$(ProwlPackageVersion)" />
    
    <PackageReference Include="Silk.NET" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <!-- <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" /> -->
    <PackageReference Include="Prowl.Ember.Contracts" Version="$(ProwlPackageVersion)" />
    <!-- EngineObject null-safety analyzer (?./??/??= on EngineObject). Analyzes this project's own source. -->
    <ProjectReference Include="..\Prowl.Analyzers\Prowl.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Defaults\**" />
    <EmbeddedResource Include="Assets\brdf_lut.brdf" />
  </ItemGroup>

  <ItemGroup>
    <LibraryFiles Include="..\Libraries\**\*.*" />
  </ItemGroup>

  <!-- Stamp each PackageReference as AssemblyMetadata so the build pipeline
       can read dependencies from the compiled DLL without needing the .csproj file. -->
  <Target Name="EmbedPackageReferences" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>PackageReference:%(PackageReference.Identity)</_Parameter1>
        <_Parameter2>%(PackageReference.Version)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- Copy native libraries to output -->
  <Target Name="CopyLibraries" AfterTargets="Build">
    <Copy SourceFiles="@(LibraryFiles)" DestinationFiles="@(LibraryFiles->'$(OutputPath)runtimes\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- Collect runtime files for referencing projects. Libraries/ already follows NuGet's
       runtimes/<rid>/native layout, so the same items serve both a ProjectReference (copied to
       output) and a PackageReference (resolved per-RID by NuGet) with no second copy. -->
  <ItemGroup>
    <None Include="..\Libraries\**\*.*">
      <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
      <Pack>true</Pack>
      <PackagePath>runtimes\</PackagePath>
    </None>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
