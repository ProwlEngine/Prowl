<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Code generation for game scripts: the passes that turn what scripts declare (networked members, for now)
    into code, before they compile. The editor's script compiler runs them in process; as an executable, the
    same passes run in `dotnet build` for projects that opt in (see build/Prowl.CodeGen.targets).
    It doesn't reference the engine, so it runs anywhere the compiler does.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Prowl.CodeGen</AssemblyName>
    <RootNamespace>Prowl.CodeGen</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Its diagnostics are reported through the script compiler, not as an analyzer's. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>../Build/CodeGen/Debug/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>../Build/CodeGen/Release/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Prowl.Editor"/>
    <InternalsVisibleTo Include="Prowl.Editor.Test"/>
    <InternalsVisibleTo Include="Prowl.CodeGen.Test"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0"/>
  </ItemGroup>

</Project>
